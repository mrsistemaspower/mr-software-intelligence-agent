{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mr-software-intelligence:schema:common:1",
  "title": "Common definitions",
  "description": "Definições compartilhadas por todos os schemas. Status de evidência e confiança são eixos independentes. Proveniência é obrigatória em toda afirmação.",
  "$defs": {
    "recordId": {
      "description": "Identificador tipado e único dentro de um pacote. Prefixos: src evd fct scr int lku wfl rul ctr rev rel.",
      "type": "string",
      "pattern": "^(src|evd|fct|scr|int|lku|wfl|rul|ctr|rev|rel):[a-z0-9][a-z0-9._-]*$"
    },
    "softwareId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "relativePath": {
      "description": "Caminho relativo ao workspace. Sem letra de unidade, sem barra inicial, sem '..'.",
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
    },
    "sourceKind": {
      "enum": ["screenshot", "filesystem", "documentation", "wiki", "source-code", "database-schema", "runtime", "release-notes", "human-expert"]
    },
    "evidenceKind": {
      "enum": ["text", "visual-element", "structure", "behavior", "metadata", "statement"]
    },
    "capability": {
      "enum": ["vision", "file-read", "file-write", "shell", "web", "structured-output", "long-context"]
    },
    "route": {
      "enum": ["AI_RECHECK", "SOURCE_GAP", "HUMAN_DECISION", "HUMAN_VALIDATION"]
    },
    "ladderStep": {
      "enum": ["prior-validated-knowledge", "evidence-reuse", "documentation", "relations", "ai-recheck", "runtime"]
    },
    "status": {
      "description": "OBSERVED = visto em evidência concreta. INFERRED = interpretação do agente. VALIDATED = confirmado por pessoa responsável nomeada.",
      "enum": ["OBSERVED", "INFERRED", "VALIDATED"]
    },
    "confidence": {
      "description": "Grau de certeza de 0 a 1, DENTRO do status. Não substitui o status.",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "actor": {
      "type": "object",
      "required": ["actor", "name"],
      "additionalProperties": false,
      "properties": {
        "actor": { "enum": ["human", "tool", "ai"] },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "provenanceEntry": {
      "type": "object",
      "required": ["source_id"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "$ref": "#/$defs/recordId", "pattern": "^src:" },
        "evidence_id": { "$ref": "#/$defs/recordId", "pattern": "^evd:" },
        "locator": { "type": "string", "minLength": 1 },
        "relation": { "enum": ["direct", "derived", "reused"] },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "validation": {
      "description": "Quem confirmou, quando e como. A pessoa responsável é sempre nomeada; agentes não se auto-validam.",
      "type": "object",
      "required": ["validated_by", "validated_at", "method"],
      "additionalProperties": false,
      "properties": {
        "validated_by": { "type": "string", "minLength": 1 },
        "validated_at": { "$ref": "#/$defs/timestamp" },
        "method": { "enum": ["human_review", "runtime_test", "authoritative_source"] },
        "review_id": { "$ref": "#/$defs/recordId", "pattern": "^rev:" },
        "scope": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "human_review" } }, "required": ["method"] },
          "then": { "required": ["review_id"] }
        }
      ]
    },
    "quarantine": {
      "description": "Retém o registro: não pode ser promovido nem usado como resposta autoritativa.",
      "type": "object",
      "required": ["reason", "since"],
      "additionalProperties": false,
      "properties": {
        "reason": { "enum": ["contradiction", "human-vs-evidence", "pending-review", "unsafe-to-use"] },
        "ref": { "$ref": "#/$defs/recordId" },
        "since": { "$ref": "#/$defs/timestamp" }
      }
    },
    "epistemic": {
      "description": "Bloco epistêmico de toda afirmação: status, confiança e proveniência de primeira classe.",
      "type": "object",
      "required": ["status", "confidence", "provenance"],
      "additionalProperties": false,
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenanceEntry" }
        },
        "basis": { "type": "string", "minLength": 1 },
        "validation": { "$ref": "#/$defs/validation" },
        "quarantine": { "$ref": "#/$defs/quarantine" },
        "valid_in_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "INFERRED" } }, "required": ["status"] },
          "then": { "required": ["basis"] }
        },
        {
          "if": { "properties": { "status": { "const": "VALIDATED" } }, "required": ["status"] },
          "then": { "required": ["validation"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["OBSERVED", "INFERRED"] } }, "required": ["status"] },
          "then": { "not": { "required": ["validation"] } }
        },
        {
          "if": { "required": ["quarantine"] },
          "then": { "properties": { "status": { "enum": ["OBSERVED", "INFERRED"] } } }
        }
      ]
    }
  }
}
