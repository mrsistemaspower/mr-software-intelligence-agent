{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mr-software-intelligence:schema:workflow:1",
  "title": "Workflow",
  "description": "Um fluxo de trabalho do software alvo (sequência de passos de negócio). Não confundir com os workflows do agente, em workflows/.",
  "type": "object",
  "required": ["id", "name", "steps", "epistemic"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "urn:mr-software-intelligence:schema:common:1#/$defs/recordId", "pattern": "^wfl:" },
    "name": { "type": "string", "minLength": 1 },
    "outcome": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "description"],
        "additionalProperties": false,
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 1 },
          "screen_id": { "$ref": "urn:mr-software-intelligence:schema:common:1#/$defs/recordId", "pattern": "^scr:" },
          "interaction_id": { "$ref": "urn:mr-software-intelligence:schema:common:1#/$defs/recordId", "pattern": "^int:" },
          "rule_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "urn:mr-software-intelligence:schema:common:1#/$defs/recordId", "pattern": "^rul:" }
          }
        }
      }
    },
    "epistemic": { "$ref": "urn:mr-software-intelligence:schema:common:1#/$defs/epistemic" }
  }
}
