{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mr-software-intelligence:schema:agent-workflow:1",
  "title": "AgentWorkflow",
  "description": "Procedimento do agente exposto como um verbo da interface. Não confundir com o schema Workflow, que descreve fluxos do software alvo.",
  "type": "object",
  "required": ["id", "verb", "summary", "inputs", "skills", "steps", "outputs", "mutates_knowledge", "escalates_to_human", "policies"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "verb": { "enum": ["learn", "explain", "ask", "find-gaps", "compare", "document"] },
    "summary": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "required", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "skill": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "gate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "mutates_knowledge": { "type": "boolean" },
    "escalates_to_human": { "type": "boolean" },
    "policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "urn:mr-software-intelligence:schema:common:1#/$defs/relativePath" }
    }
  }
}
